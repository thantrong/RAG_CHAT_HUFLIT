# ============================================================
# RAG_CHAT — Mẫu cấu hình môi trường
# Copy file này thành .env rồi điền giá trị thật:
#     cp .env.example .env
# .env KHÔNG được commit (đã có trong .gitignore).
# ============================================================

# --- PostgreSQL (Docker: db-postgres-ltw) ---
# Mật khẩu kết nối DB. settings.py dựng URL:
#   postgresql://postgres:{DB_PASSWORD}@localhost:5432/student_rag
# (host/port/database/username xem config/database.yaml)
DB_PASSWORD=your_postgres_password

# --- VoyageAI (embedding + rerank) ---
# Lấy tại https://dash.voyageai.com/api-keys
# Dùng cho: config/embedding.yaml (voyage-4) + config/reranker.yaml (rerank-2.5)
VOYAGE_API_KEY=pa-your_voyage_api_key

# --- Google Gemini (LLM sinh câu trả lời) ---
# Lấy tại https://aistudio.google.com/apikey
# Dùng cho: config/llm.yaml (gemini-3.5-flash-lite)
GOOGLE_API_KEY=your_google_api_key

# --- Tài khoản HUFLIT (tải file SharePoint) ---
# Chỉ cần khi chạy scripts/download_external.py
HUFLIT_USERNAME=your_mssv@st.huflit.edu.vn
HUFLIT_PASSWORD=your_password
